# --- Required for Claude-written facts (server only; never exposed to the browser)
ANTHROPIC_API_KEY=

# --- Optional
# Model and effort for fact writing. Defaults: claude-opus-5-5, low effort.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# USE_CLAUDE=0              # serve computed (template) facts only, no model calls

# Nominatim's usage policy asks for an identifying User-Agent with contact details.
APP_USER_AGENT=GlobeFacts/0.1 (https://your-site.example; you@example.com)
# NOMINATIM_EMAIL=you@example.com
# NOMINATIM_URL=https://nominatim.openstreetmap.org   # or your own instance

# PORT=8787
# FACT_LOG_PATH=logs/facts.jsonl   # every fact + the exact data it came from
# RATE_LIMIT_PER_MIN=30            # per IP
# GATHER_BUDGET_MS=6000            # max time spent collecting source data per tap
# EXPOSE_FACT_DATA=1               # include source data in API responses in production

# --- Web client (baked in at build time by Vite)
# VITE_SATELLITE_TILES=https://api.maptiler.com/tiles/satellite-v2/{z}/{x}/{y}.jpg?key=YOUR_MAPTILER_KEY
# VITE_SATELLITE_ATTRIBUTION=© MapTiler © Maxar
# VITE_API_BASE=https://your-deployed-api.example   # only when the web app and API are on different origins (e.g. Capacitor)
